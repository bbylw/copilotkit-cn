---
import BrandMark from "./BrandMark.astro";
import { footerColumns, externalLinks, site } from "../data/site";

const year = new Date().getFullYear();
---

<footer class="relative mt-24 overflow-hidden border-t border-white/8 bg-ink-900/40">
  <div class="shell py-14 md:py-20">
    <div class="grid gap-12 lg:grid-cols-[1.4fr_2fr]">
      <div class="max-w-sm">
        <a href="/" class="inline-flex items-center gap-2.5" aria-label="CopilotKit 首页">
          <BrandMark size={28} />
          <span class="latin text-[1.0625rem] font-medium text-mist-50">CopilotKit</span>
        </a>
        <p class="mt-5 text-sm leading-relaxed text-mist-400">
          智能体与用户之间的横向连接层。同一个智能体，驱动 Web、移动端与聊天平台。
        </p>
        <div class="mt-6 flex flex-wrap gap-2">
          <span class="pill cjk-safe">MIT 协议</span>
          <span class="pill cjk-safe">AG-UI 共建方</span>
          <span class="pill cjk-safe">中文文档</span>
        </div>
      </div>

      <div class="grid grid-cols-2 gap-8 sm:grid-cols-3">
        {
          footerColumns.map((col) => (
            <nav aria-label={col.title}>
              <h2 class="label-muted">{col.title}</h2>
              <ul class="mt-4 space-y-3">
                {col.links.map((link) => (
                  <li>
                    <a
                      href={link.href}
                      target={link.external ? "_blank" : undefined}
                      rel={link.external ? "noreferrer noopener" : undefined}
                      class="group inline-flex items-baseline gap-1.5 text-sm text-mist-200 transition-colors duration-200 hover:text-mist-50"
                    >
                      {link.label}
                      {link.external && (
                        <svg
                          width="9"
                          height="9"
                          viewBox="0 0 10 10"
                          fill="none"
                          aria-hidden="true"
                          class="translate-y-[-1px] opacity-40 transition-opacity group-hover:opacity-90"
                        >
                          <path
                            d="M2 8L8 2M8 2H3.5M8 2v4.5"
                            stroke="currentColor"
                            stroke-width="1.4"
                            stroke-linecap="round"
                            stroke-linejoin="round"
                          />
                        </svg>
                      )}
                    </a>
                  </li>
                ))}
              </ul>
            </nav>
          ))
        }
      </div>
    </div>

    <div class="rule mt-14"></div>

    <div
      aria-hidden="true"
      class="pointer-events-none mt-10 overflow-hidden select-none"
      data-reveal
    >
      <p class="latin bg-gradient-to-b from-white/12 to-white/[0.015] bg-clip-text text-center text-[clamp(3.5rem,12vw,10.5rem)] leading-[0.95] font-bold tracking-tight text-transparent">
        CopilotKit
      </p>
    </div>

    <div class="mt-6 flex flex-col gap-3 text-xs text-mist-600 sm:flex-row sm:items-center sm:justify-between">
      <p>© {year} CopilotKit. 源码以 MIT 协议开放。</p>
      <p class="flex flex-wrap items-center gap-x-4 gap-y-1">
        <a href={externalLinks.license} target="_blank" rel="noreferrer noopener" class="transition-colors hover:text-mist-200">
          许可证
        </a>
        <a href={externalLinks.agui} target="_blank" rel="noreferrer noopener" class="transition-colors hover:text-mist-200">
          AG-UI 协议
        </a>
        <a href={externalLinks.npm} target="_blank" rel="noreferrer noopener" class="transition-colors hover:text-mist-200">
          npm
        </a>
        <span class="latin">{site.locale}</span>
      </p>
    </div>
  </div>
</footer>