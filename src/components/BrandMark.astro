---
/**
 * Official CopilotKit kite mark, sourced from the project README assets.
 * Served as a static file so it is cached once and reused everywhere.
 */
interface Props {
  size?: number;
  class?: string;
}

const { size = 32, class: className = "" } = Astro.props;
---

<img
  src="/images/copilotkit-kite.png"
  alt="CopilotKit"
  width={256}
  height={256}
  loading="eager"
  decoding="async"
  style={`width: ${size}px; height: ${size}px`}
  class={className}
/>