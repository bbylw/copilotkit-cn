---
/** External-link arrow. Used as a shared component so the icon geometry
    lives in exactly one place. */
interface Props {
  size?: number;
  class?: string;
}

const { size = 11, class: className = "" } = Astro.props;
---

<svg width={size} height={size} viewBox="0 0 10 10" fill="none" aria-hidden="true" class={className}>
  <path
    d="M2 8L8 2M8 2H3.5M8 2v4.5"
    stroke="currentColor"
    stroke-width="1.4"
    stroke-linecap="round"
    stroke-linejoin="round"></path>
</svg>